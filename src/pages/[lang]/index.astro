---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import BodyMap from '../../components/BodyMap.astro';
import Contact from '../../components/Contact.astro';
import ui from '../../content/ui.json';
import categories from '../../content/categories.json';
import conditions from '../../content/conditions-index.json';
import keywords from '../../content/search-keywords.json';
import { LANGS, t, url } from '../../lib/i18n';
import { asset, catImg, thumbImg } from '../../lib/assets';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const ready = new Set(
  Object.values(import.meta.glob('../../content/conditions/*.json', { eager: true }) as Record<string, { default: any }>).map((m) => m.default.slug as string)
);
const lang = Astro.params.lang as Lang;
const catName = (slug: string) => categories.find((c) => c.slug === slug)!;
const catIcon = (slug: string) => catName(slug).icon;
const logo = asset('img/logo');
const kw = keywords as Record<string, string>;
const norm = (x: string) => x.normalize('NFD').replace(/[\u093c\u200b-\u200d]/g, '').toLowerCase();
---

<Base lang={lang} title={`${t(ui.homeTitle, lang)} | Dr. Devarsh Goyal`}>
  <header class="topbar">
    <a class="brand" href={url(`${lang}/`)} aria-label={t(ui.home, lang)}>
      <span class={`logo-badge${logo ? " has-img" : ""}`}>{logo ? <img src={logo} alt="" /> : <Icon name="logo" size={24} />}</span>
      <span class="brand-name">Know Your Condition</span>
    </a>
    <LangSwitch lang={lang} hrefEn={url('en/')} hrefHi={url('hi/')} />
  </header>

  <main class="sheet">
    <div>
      <h1>{t(ui.homeTitle, lang)}</h1>
      <p class="sub">{t(ui.homeSub, lang)}</p>
    </div>

    <div class="mode" role="tablist">
      <button type="button" role="tab" data-mode="search" aria-selected="true">{lang === 'hi' ? 'खोजें' : 'Search'}</button>
      <button type="button" role="tab" data-mode="body" aria-selected="false">{lang === 'hi' ? 'शरीर से ढूंढें' : 'By body part'}</button>
    </div>

    <div id="mode-search">
    <div class="search">
      <label class="sr-only" for="q">{t(ui.search, lang)}</label>
      <input id="q" type="search" placeholder={t(ui.search, lang)} autocomplete="off" enterkeyhint="search" />
      <span class="search-icon"><Icon name="search" size={24} stroke={3} /></span>
    </div>

    <ul id="results" class="cond-list" hidden>
      {conditions.map((c) => (
        <li data-q={norm(`${c.name.en} ${c.name.hi} ${c.short.en} ${c.short.hi} ${catName(c.category).name.en} ${kw[c.slug] ?? ''}`)} hidden>
          {ready.has(c.slug) ? (
            <a class="cond-card" href={url(`${lang}/${c.slug}/`)}>
              <span class="thumb">{thumbImg(c.slug, c.category) ? <img src={thumbImg(c.slug, c.category)!} alt="" loading="lazy" /> : <Icon name={catIcon(c.category)} size={40} />}</span>
              <span class="body">
                <span class="name">{t(c.name, lang)}</span>
                <span class="desc">{t(c.short, lang)}</span>
              </span>
              <span class="go"><Icon name="arrow" size={22} stroke={3} /></span>
            </a>
          ) : (
            <div class="cond-card is-soon">
              <span class="thumb">{thumbImg(c.slug, c.category) ? <img src={thumbImg(c.slug, c.category)!} alt="" loading="lazy" /> : <Icon name={catIcon(c.category)} size={40} />}</span>
              <span class="body">
                <span class="name">{t(c.name, lang)}</span>
                <span class="desc">{t(c.short, lang)}</span>
              </span>
              <span class="tag-soon">{t(ui.comingSoon, lang)}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
    <p id="none" class="empty" hidden>{t(ui.noResults, lang)}</p>

    <nav id="cats" class="cat-grid" aria-label={t(ui.homeSub, lang)}>
      {categories.map((c) => (
        <a class="cat-card" href={url(`${lang}/category/${c.slug}/`)}>
          <span class="icon-wrap">{catImg(c.slug) ? <img src={catImg(c.slug)!} alt="" loading="lazy" /> : <Icon name={c.icon} size={56} />}</span>
          <span>{t(c.name, lang)}</span>
        </a>
      ))}
    </nav>

    </div>

    <div id="mode-body" hidden>
      <BodyMap lang={lang} ready={ready} />
    </div>

    <Contact lang={lang} safety={false} />
    <p class="disclaimer">{t(ui.disclaimer, lang)}</p>
  </main>
</Base>

<script is:inline>
  (function () {
    var modes = document.querySelectorAll('[data-mode]');
    function setMode(m, save) {
      modes.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-mode') === m ? 'true' : 'false'); });
      document.getElementById('mode-search').hidden = m !== 'search';
      document.getElementById('mode-body').hidden = m !== 'body';
      if (save) { try { localStorage.setItem('kyc-mode', m); } catch (e) {} }
    }
    modes.forEach(function (b) { b.addEventListener('click', function () { setMode(b.getAttribute('data-mode'), true); }); });
    try { if (localStorage.getItem('kyc-mode') === 'body') setMode('body', false); } catch (e) {}
  })();
  (function () {
    var q = document.getElementById('q');
    var list = document.getElementById('results');
    var none = document.getElementById('none');
    var cats = document.getElementById('cats');
    var items = list.querySelectorAll('li');
    function norm(x) {
      return x.normalize('NFD').replace(/[\u093c\u200b-\u200d]/g, '').toLowerCase();
    }
    q.addEventListener('input', function () {
      var v = norm(q.value).trim();
      var all = v.split(/\s+/).filter(Boolean);
      var stop = ['ka', 'ki', 'ke', 'ko', 'mein', 'me', 'se', 'hai', 'ho', 'par', 'pe', 'aur', 'the', 'of', 'in', 'my', 'is', 'का', 'की', 'के', 'को', 'में', 'से', 'है', 'पर', 'और'];
      var words = all.filter(function (w) { return stop.indexOf(w) === -1; });
      if (!words.length) words = all;
      var shown = 0;
      var scores = [];
      items.forEach(function (li) {
        var hay = li.getAttribute('data-q');
        var sc = 0;
        words.forEach(function (w) { if (hay.indexOf(w) !== -1) sc++; });
        scores.push(sc);
      });
      var max = scores.reduce(function (m, x) { return x > m ? x : m; }, 0);
      items.forEach(function (li, i) {
        var hit = words.length > 0 && max > 0 && scores[i] === max;
        li.hidden = !hit;
        if (hit) shown++;
      });
      list.hidden = !v || shown === 0;
      none.hidden = !v || shown > 0;
      cats.hidden = !!v;
    });
  })();
</script>
