---
import { url } from '../lib/i18n';
const home = url('');
---
<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Know Your Condition</title>
    <noscript><meta http-equiv="refresh" content={`0;url=${home}`} /></noscript>
    <style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#f4f8fb;color:#0a1f33}a{color:#0e8f84;font-weight:700}</style>
  </head>
  <body>
    <p><a href={home}>Know Your Condition</a></p>
    <script is:inline data-goatcounter="https://kyc-devarsh.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script is:inline define:vars={{ home }}>
      setTimeout(function () { location.replace(home); }, 700);
    </script>
  </body>
</html>
