---
import '../styles/global.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/noto-sans-devanagari/500.css';
import '@fontsource/noto-sans-devanagari/600.css';
import '@fontsource/noto-sans-devanagari/700.css';
import '@fontsource/noto-sans-devanagari/800.css';
import type { Lang } from '../lib/i18n';
import { url } from '../lib/i18n';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description?: string;
  lang?: Lang; // omitted on the welcome page (it handles both languages)
}
const { title, description = 'Simple, reliable orthopaedic patient education by Dr. Devarsh Goyal.', lang } = Astro.props;
---

<!doctype html>
<html lang={lang ?? 'hi'} data-lang={lang ?? 'hi'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#102A43" />
    <meta name="description" content={description} />
    <meta name="author" content="Dr. Devarsh Goyal" />
    <meta name="copyright" content={site.copyright} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      try {
        var f = parseInt(localStorage.getItem('kyc-fs'), 10);
        if (localStorage.getItem('kyc-hc') === '1') document.documentElement.setAttribute('data-hc', '1');
        if (f === 1 || f === 2) document.documentElement.style.fontSize = [18, 21, 24][f] + 'px';
      } catch (e) {}
    </script>
    {!lang && (
      <script is:inline>
        try {
          var l = localStorage.getItem('kyc-lang');
          if (l === 'en' || l === 'hi') document.documentElement.setAttribute('data-lang', l);
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <div class="app">
      <slot />
      <SiteFooter lang={lang} />
    </div>
    <script is:inline data-goatcounter="https://kyc-devarsh.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    <script is:inline>
      (function () {
        function ev(name) {
          try {
            if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path: 'event/' + name, title: name, event: true });
          } catch (e) {}
        }
        var slug = (location.pathname.replace(/\/+$/, '').split('/').pop() || 'home');
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          if (t.closest('.ab-pdf, .print-btn')) ev('pdf-' + slug);
          else if (t.closest('#wa-share')) ev('whatsapp-' + slug);
          else if (t.closest('.ex-share')) ev('exercise-share-' + slug);
          else if (t.closest('[data-listen-btn]')) ev('listen-' + slug);
          else {
            var r = t.closest('[data-bm-region]');
            if (r) ev('bodymap-' + r.getAttribute('data-bm-region'));
          }
        });
      })();
    </script>
  </body>
</html>
