---
// Original, simple SVG illustrations used until real artwork is dropped in
// (a condition JSON can point to an image file instead; see ExerciseCard / hero).
interface Props {
  kind: string;
  label?: string;
}
const { kind, label = '' } = Astro.props;

const SKIN = '#f1c7a3';
const HAIR = '#102a43';
const SHIRT = '#20a69a';
const SHIRT_D = '#178579';
const ARROW = '#d64545';
const SOFT = '#e3f5f3';

const arrowL = (x: number, y: number, len = 18) =>
  `<path d="M${x} ${y}h${-len}" stroke="${ARROW}" stroke-width="4" stroke-linecap="round"/><path d="M${x - len} ${y}l7 -6v12z" fill="${ARROW}" stroke="${ARROW}" stroke-width="1.5" stroke-linejoin="round"/>`;
const arrowR = (x: number, y: number, len = 18) =>
  `<path d="M${x} ${y}h${len}" stroke="${ARROW}" stroke-width="4" stroke-linecap="round"/><path d="M${x + len} ${y}l-7 -6v12z" fill="${ARROW}" stroke="${ARROW}" stroke-width="1.5" stroke-linejoin="round"/>`;

const torsoFront = `<path d="M52 150V118Q52 98 78 94H122Q148 98 148 118V150Z" fill="${SHIRT}"/>`;
const neckFront = `<rect x="91" y="74" width="18" height="26" rx="6" fill="${SKIN}"/>`;
const headFront = `
  <circle cx="100" cy="52" r="24" fill="${SKIN}"/>
  <path d="M76 50Q76 26 100 26Q124 26 124 50Q112 38 100 38Q86 38 76 50Z" fill="${HAIR}"/>
  <circle cx="92" cy="54" r="2" fill="${HAIR}"/><circle cx="108" cy="54" r="2" fill="${HAIR}"/>
  <path d="M94 64Q100 69 106 64" stroke="${HAIR}" stroke-width="2" fill="none" stroke-linecap="round"/>`;

// Neck-spine hero (side view)
const offs = [0, 3, 5, 6, 5, 3, 0];
let spine = '';
let discs = '';
for (let i = 0; i < 7; i++) {
  const cx = 150 - offs[i];
  const cy = 108 + i * 15.5;
  spine += `<rect x="${cx - 14}" y="${cy - 6}" width="28" height="12" rx="4.5" fill="#fff" stroke="#102a43" stroke-width="2"/>`;
  if (i < 6) {
    const dy = cy + 7.75;
    const dx = 150 - (offs[i] + offs[i + 1]) / 2;
    const hot = i === 4;
    discs += `<ellipse cx="${dx}" cy="${dy}" rx="${hot ? 13 : 12}" ry="${hot ? 3.4 : 2.6}" fill="${hot ? ARROW : SHIRT}" stroke="#102a43" stroke-width="1.4"/>`;
  }
}

const svgs: Record<string, string> = {
  'neck-spine': `
  <svg viewBox="0 0 320 230" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${label}">
    <defs>
      <linearGradient id="bgn" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e3f5f3"/><stop offset="1" stop-color="#f4f8fa"/></linearGradient>
    </defs>
    <rect width="320" height="230" fill="url(#bgn)"/>
    <path d="M60 230Q64 196 120 186L180 186Q250 192 260 230Z" fill="${SHIRT}" opacity=".9"/>
    <path d="M112 100Q104 92 108 70Q112 44 150 40Q196 36 206 70Q214 92 200 104Q200 118 196 128L186 128" fill="${SKIN}" stroke="#102a43" stroke-width="2.2" stroke-linejoin="round"/>
    <path d="M110 74Q116 40 156 38Q200 36 206 70Q176 52 140 62Q122 68 110 74Z" fill="${HAIR}"/>
    <path d="M198 84l9 5-8 5" fill="none" stroke="#102a43" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M124 106Q118 150 126 196" fill="none" stroke="#102a43" stroke-width="2" opacity=".35"/>
    <path d="M138 104Q132 150 140 196" fill="none" stroke="#e3a33b" stroke-width="5" stroke-linecap="round" opacity=".9"/>
    ${spine}${discs}
    <path d="M168 168Q196 170 214 196" fill="none" stroke="#e3a33b" stroke-width="3.5" stroke-linecap="round"/>
    <circle cx="196" cy="147" r="15" fill="none" stroke="${ARROW}" stroke-width="2.5" stroke-dasharray="4 4"/>
  </svg>`,

  'chin-tuck': `
  <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${label}">
    <rect width="200" height="150" fill="${SOFT}"/>
    <path d="M62 150V116Q62 98 86 94H114Q138 98 138 116V150Z" fill="${SHIRT}"/>
    <rect x="92" y="74" width="18" height="26" rx="6" fill="${SKIN}"/>
    <circle cx="122" cy="52" r="24" fill="none" stroke="${SHIRT_D}" stroke-width="2.5" stroke-dasharray="5 5"/>
    <ellipse cx="100" cy="52" rx="23" ry="25" fill="${SKIN}"/>
    <path d="M78 52Q78 26 102 26Q120 27 122 46Q108 36 96 41Q86 46 82 60Z" fill="${HAIR}"/>
    <path d="M122 54l7 4-7 3" fill="${SKIN}" stroke="#102a43" stroke-width="2" stroke-linejoin="round"/>
    <circle cx="112" cy="50" r="2" fill="${HAIR}"/>
    ${arrowL(166, 62, 22)}
  </svg>`,

  'neck-isometrics': `
  <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${label}">
    <rect width="200" height="150" fill="${SOFT}"/>
    ${torsoFront}${neckFront}${headFront}
    <path d="M52 124Q40 96 62 62" stroke="${SKIN}" stroke-width="14" fill="none" stroke-linecap="round"/>
    <rect x="62" y="38" width="18" height="30" rx="9" fill="${SKIN}" stroke="#102a43" stroke-width="1.6"/>
    ${arrowR(34, 52, 18)}
    ${arrowL(166, 52, 18)}
  </svg>`,

  'neck-stretch': `
  <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${label}">
    <rect width="200" height="150" fill="${SOFT}"/>
    ${torsoFront}
    <path d="M110 80Q126 90 132 98" stroke="${SHIRT_D}" stroke-width="5" stroke-linecap="round" fill="none" stroke-dasharray="1 8"/>
    <g transform="rotate(-18 100 90)">
      ${neckFront}${headFront}
      <rect x="98" y="21" width="32" height="13" rx="6.5" fill="${SKIN}" stroke="#102a43" stroke-width="1.6" transform="rotate(20 114 27)"/>
    </g>
    <path d="M142 18Q172 30 164 62" fill="none" stroke="${ARROW}" stroke-width="4" stroke-linecap="round"/>
    <path d="M164 68l-8 -7 14 -3z" fill="${ARROW}" stroke="${ARROW}" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>`,

  'shoulder-squeeze': `
  <svg viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="${label}">
    <rect width="200" height="150" fill="${SOFT}"/>
    <path d="M52 150V118Q52 98 78 94H122Q148 98 148 118V150Z" fill="${SHIRT}"/>
    <path d="M82 104Q92 128 100 136Q108 128 118 104" fill="none" stroke="${SHIRT_D}" stroke-width="3" stroke-linecap="round"/>
    <rect x="91" y="74" width="18" height="26" rx="6" fill="${SKIN}"/>
    <circle cx="100" cy="52" r="24" fill="${HAIR}"/>
    <path d="M60 140V116" stroke="${SKIN}" stroke-width="12" stroke-linecap="round"/>
    <path d="M140 140V116" stroke="${SKIN}" stroke-width="12" stroke-linecap="round"/>
    ${arrowR(58, 118, 18)}
    ${arrowL(142, 118, 18)}
  </svg>`,
};
const svg = svgs[kind] ?? '';
---

<Fragment set:html={svg} />
