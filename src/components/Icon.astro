---
// Original line icons. Colour comes from `currentColor`; soft fill from --icon-fill.
interface Props {
  name: string;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 52, stroke = 2.2, class: cls = '' } = Astro.props;

const F = 'var(--icon-fill, #cdeeea)';

const shapes: Record<string, string> = {
  knee: `
    <path d="M19 3h10c0 7-.8 11-1.2 14.5 3.6.6 6.2 3 6.2 6 0 3.2-3 4.5-6.5 4.5h-7c-3.500 0-6.500-1.300-6.500-4.500 0-3 2.600-5.400 6.200-6C19.800 14 19 10 19 3z" fill="${F}"/>
    <path d="M15 32.500c3 .8 15 .8 18 0 .6 0 1 .4 1 1 0 1.500-1.600 2.500-3 2.800L30 44.500h-12l-1-8.200c-1.400-.3-3-1.300-3-2.800 0-.6.400-1 1-1z" fill="${F}"/>`,
  shoulder: `
    <path d="M6 20C6 9 14 4 24 6" />
    <circle cx="19" cy="19" r="8.500" fill="${F}"/>
    <path d="M24.500 24.500l8.500 17.500" stroke-width="9" stroke="currentColor"/>
    <path d="M24.500 24.500l8.500 17.500" stroke-width="5.200" stroke="${F}"/>`,
  spine: `
    <rect x="17" y="3" width="14" height="7" rx="3" fill="${F}"/>
    <rect x="15" y="12" width="17" height="7" rx="3" fill="${F}"/>
    <rect x="14" y="21" width="19" height="7" rx="3" fill="${F}"/>
    <rect x="15" y="30" width="18" height="7" rx="3" fill="${F}"/>
    <rect x="17" y="39" width="15" height="6" rx="3" fill="${F}"/>`,
  foot: `
    <path d="M13 3h11v18c0 2.800 1.800 4.600 5 5.500l9 2.500c3 .9 5 3.200 5 6.500v4.500c0 1.700-1.300 3-3 3H12.500C10.500 43 9 41.500 9 39.500c0-4.500 2.500-8 4-10z" fill="${F}"/>
    <path d="M36 37v6M41 38.500V43"/>`,
  hand: `
    <rect x="9" y="22" width="6" height="14" rx="3" transform="rotate(-24 12 29)" fill="${F}"/>
    <rect x="16" y="6" width="6" height="22" rx="3" fill="${F}"/>
    <rect x="23.5" y="3" width="6" height="25" rx="3" fill="${F}"/>
    <rect x="31" y="7" width="6" height="21" rx="3" fill="${F}"/>
    <path d="M16 28h21v6c0 6-4 11-10.5 11S16 40 16 34z" fill="${F}"/>`,
  fracture: `
    <g transform="rotate(-40 24 24)">
      <rect x="3" y="15" width="42" height="18" rx="9" fill="${F}"/>
      <rect x="17" y="15" width="14" height="18" fill="${F}"/>
      <circle cx="10" cy="21" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="10" cy="27" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="38" cy="21" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="38" cy="27" r="1.2" fill="currentColor" stroke="none"/>
    </g>`,
  search: `
    <circle cx="21" cy="21" r="12"/><path d="M30 30l12 12"/>`,
  back: `<path d="M30 8L14 24l16 16"/>`,
  arrow: `<path d="M18 8l16 16-16 16"/>`,
  logo: `
    <path d="M19 5h10c0 6-.7 9.500-1 12.500 3.200.5 5.500 2.600 5.500 5.300 0 2.800-2.700 4-5.800 4h-6.400c-3.100 0-5.800-1.200-5.800-4 0-2.700 2.300-4.800 5.500-5.300-.3-3-1-6.500-1-12.500z" fill="currentColor" stroke="none"/>
    <path d="M16.500 31.500c2.800.7 12.200.7 15 0 .5 0 .8.4.8.9 0 1.200-1.200 2-2.500 2.300L28.500 43h-9l-1.300-8.300c-1.300-.3-2.500-1.100-2.500-2.300 0-.5.300-.9.8-.9z" fill="currentColor" stroke="none"/>`,
};

const inner = shapes[name] ?? '';
---

<svg
  class={`icon ${cls}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
