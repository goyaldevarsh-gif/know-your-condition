---
import site from '../content/site.json';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
interface Props { lang?: Lang }
const { lang } = Astro.props;
const langs: Lang[] = lang ? [lang] : ['en', 'hi'];
---
<footer class="site-foot">
  {lang ? (
    <>
      <p class="sf-name">{t(site.doctor, lang)}<span> · {t(site.degree, lang)}</span></p>
      <p class="sf-copy">{t(site.copyright, lang)}</p>
      <p class="sf-rights" lang={lang}>{t(site.rights, lang)}</p>
    </>
  ) : (
    <>
      <p class="sf-name"><span class="l-en">{t(site.doctor, 'en')}<span> · {t(site.degree, 'en')}</span></span><span class="l-hi">{t(site.doctor, 'hi')}<span> · {t(site.degree, 'hi')}</span></span></p>
      <p class="sf-copy"><span class="l-en">{t(site.copyright, 'en')}</span><span class="l-hi">{t(site.copyright, 'hi')}</span></p>
      <p class="sf-rights"><span class="l-en" lang="en">{t(site.rights, 'en')}</span><span class="l-hi" lang="hi">{t(site.rights, 'hi')}</span></p>
    </>
  )}
</footer>
