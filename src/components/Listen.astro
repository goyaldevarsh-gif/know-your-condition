---
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const hi = lang === 'hi';
const L = {
  listen: hi ? 'सुनें' : 'Listen',
  stop: hi ? 'रोकें' : 'Stop',
  none: hi ? 'इस फ़ोन में आवाज़ उपलब्ध नहीं है।' : 'Voice is not available on this phone.',
};
---

<div class="listen" data-listen hidden data-lang={lang}>
  <button type="button" class="listen-btn" data-listen-btn aria-pressed="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
    <span data-listen-label data-t-listen={L.listen} data-t-stop={L.stop}>{L.listen}</span>
  </button>
  <p class="listen-none" data-listen-none hidden>{L.none}</p>
</div>

<script is:inline>
  (function () {
    var box = document.querySelector('[data-listen]');
    if (!box || !('speechSynthesis' in window) || typeof SpeechSynthesisUtterance === 'undefined') return;
    box.hidden = false;
    var btn = box.querySelector('[data-listen-btn]');
    var label = box.querySelector('[data-listen-label]');
    var none = box.querySelector('[data-listen-none]');
    var hi = box.getAttribute('data-lang') === 'hi';
    var synth = window.speechSynthesis;
    var playing = false, token = 0;

    function pickVoice() {
      var vs = synth.getVoices() || [];
      var pre = hi ? ['hi'] : ['en-in', 'en'];
      for (var i = 0; i < pre.length; i++) {
        for (var j = 0; j < vs.length; j++) {
          if (vs[j].lang && vs[j].lang.toLowerCase().replace('_', '-').indexOf(pre[i]) === 0) return vs[j];
        }
      }
      return null;
    }
    function setPlaying(v) {
      playing = v;
      btn.setAttribute('aria-pressed', String(v));
      btn.classList.toggle('on', v);
      label.textContent = v ? label.getAttribute('data-t-stop') : label.getAttribute('data-t-listen');
    }
    function stop() { token++; synth.cancel(); setPlaying(false); }

    function panelText() {
      var p = document.querySelector('[data-panel]:not([hidden])');
      if (!p) return '';
      var c = p.cloneNode(true);
      c.querySelectorAll('button, svg, img, .rf-badge, .m-tag, .chev, script, style').forEach(function (n) { n.remove(); });
      var parts = [];
      c.querySelectorAll('h2, h3, h4, p, li, summary').forEach(function (n) {
        if (n.closest('li') && n.tagName !== 'LI') return;
        var t = (n.textContent || '').replace(/\s+/g, ' ').trim();
        if (t) parts.push(t);
      });
      return parts.join('. ').replace(/\.\s*\./g, '.');
    }
    function chunks(text) {
      var out = [], cur = '';
      text.split(/(?<=[.।?!:])\s+/).forEach(function (s) {
        if ((cur + ' ' + s).length > 180 && cur) { out.push(cur); cur = s; } else { cur = cur ? cur + ' ' + s : s; }
      });
      if (cur) out.push(cur);
      return out;
    }
    function speak() {
      var voice = pickVoice();
      if (hi && !voice) { none.hidden = false; return; }
      none.hidden = true;
      var list = chunks(panelText());
      if (!list.length) return;
      var my = ++token;
      synth.cancel();
      setPlaying(true);
      list.forEach(function (txt, i) {
        var u = new SpeechSynthesisUtterance(txt);
        u.lang = voice ? voice.lang : (hi ? 'hi-IN' : 'en-IN');
        if (voice) { try { u.voice = voice; } catch (e) {} }
        u.rate = 0.9;
        u.onend = function () { if (my === token && i === list.length - 1) setPlaying(false); };
        u.onerror = function () { if (my === token && i === list.length - 1) setPlaying(false); };
        synth.speak(u);
      });
    }
    btn.addEventListener('click', function () { if (playing) stop(); else speak(); });
    document.querySelectorAll('[data-tab],[data-goto]').forEach(function (b) { b.addEventListener('click', stop); });
    window.addEventListener('pagehide', function () { synth.cancel(); });
    if (synth.addEventListener) synth.addEventListener('voiceschanged', function () {});
  })();
</script>
