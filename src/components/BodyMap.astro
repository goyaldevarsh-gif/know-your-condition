---
import Icon from './Icon.astro';
import bm from '../content/bodymap.json';
import conditions from '../content/conditions-index.json';
import { t, url } from '../lib/i18n';
import { asset, thumbImg } from '../lib/assets';
import type { Lang } from '../lib/i18n';

interface Props { lang: Lang; ready: Set<string> }
const { lang, ready } = Astro.props;
const hi = lang === 'hi';
const S = {
  prompt: hi ? 'जहाँ दर्द है, उस हिस्से को छुएं' : 'Tap the part that hurts',
  male: hi ? 'पुरुष' : 'Male',
  female: hi ? 'महिला' : 'Female',
  front: hi ? 'आगे' : 'Front',
  back: hi ? 'पीछे' : 'Back',
  other: hi ? 'प्लास्टर या ऑपरेशन' : 'Plaster or surgery',
  none: hi ? 'जल्द आ रहा है' : 'Coming soon',
  soon: hi ? 'इस हिस्से की जानकारी जल्द आएगी। अभी दर्द हो तो डॉक्टर से पूछें।' : 'Information for this part is coming soon. If it hurts, please ask the doctor.',
};
const fem: any = (bm as any).female;
const withFem = (rs: any[], k: 'front' | 'back') => rs.map((r) => ({ ...r, ...fem[k][r.id] }));
const views = [
  { key: 'front', label: S.front, regions: bm.front },
  { key: 'back', label: S.back, regions: bm.back },
] as const;
const figs = [
  ...views.map((v) => ({ v: v.key, g: 'm', img: asset(`img/bodymap/${v.key}`), regions: v.regions as any[] })),
  ...views.map((v) => ({ v: v.key, g: 'f', img: asset(`img/bodymap/${v.key}-f`), regions: withFem(v.regions as any[], v.key) })),
];
const boxes = [
  {
    cat: 'general-care',
    title: hi ? 'आम देखभाल' : 'General Care',
    sub: hi ? 'बर्फ या सेक, चलने का सहारा, जूते-चप्पल, सोना-बैठना, बिस्तर पर देखभाल' : 'Ice or heat, walking aids, footwear, sleeping and sitting, bed care',
    slugs: ['ice-or-heat', 'walking-aids', 'footwear', 'daily-posture'],
  },
  {
    cat: 'cast-surgery-care',
    title: hi ? 'प्लास्टर और ऑपरेशन की देखभाल' : 'Plaster and Surgery Care',
    sub: hi ? 'हाथ-पैर का प्लास्टर, नहाना, ऑपरेशन के बाद की देखभाल' : 'Arm and leg plaster, bathing with a cast, care after surgery',
    slugs: ['cast-care-upper-limb', 'cast-care-lower-limb', 'bathing-cast-brace', 'post-surgery-care'],
  },
];
const byslug = (s: string) => conditions.find((c) => c.slug === s);
const card = (s: string) => {
  const c = byslug(s);
  return c && ready.has(s) ? c : null;
};
const allPanels = [...bm.front, ...bm.back].filter((r, i, a) => a.findIndex((x) => x.id === r.id) === i);
---

<div class="bm" data-bodymap>
  <p class="bm-prompt">{S.prompt}</p>
  <div class="bm-switch" role="tablist">
    {views.map((v, i) => (
      <button type="button" role="tab" data-bm-view={v.key} aria-selected={i === 0 ? 'true' : 'false'}>{v.label}</button>
    ))}
  </div>

  <div class="bm-switch bm-gender" role="tablist">
    <button type="button" role="tab" data-bm-g="m" aria-selected="true">{S.male}</button>
    <button type="button" role="tab" data-bm-g="f" aria-selected="false">{S.female}</button>
  </div>

  {figs.map((v) => (
    <div class="bm-fig" data-bm-fig={v.v} data-bm-gen={v.g} hidden={!(v.v === 'front' && v.g === 'm')}>
      {v.img && <img src={v.img} alt="" width={bm.w} height={bm.h} decoding="async" />}
      <svg viewBox={`0 0 ${bm.w} ${bm.h}`} aria-label={S.prompt}>
        {v.regions.map((r) => {
          const name = t(r.name, lang);
          const fs = name.length > 11 ? 31 : name.length > 8 ? 34 : 38;
          return (
            <g class="bm-hot" role="button" tabindex="0" data-bm-region={r.id} aria-label={name}>
              <rect class="bm-box" x={r.box[0] - 8} y={r.box[1] - 7} width={r.box[2] + 16} height={r.box[3] + 14} rx="16" />
              <text x={r.box[0] + r.box[2] / 2} y={r.box[1] + r.box[3] / 2 + 1} text-anchor="middle" dominant-baseline="middle" font-size={fs}>{name}</text>
              <circle class="bm-dot" cx={r.dot[0]} cy={r.dot[1]} r="22" />
            </g>
          );
        })}
      </svg>
    </div>
  ))}

  <div class="bm-out" aria-live="polite">
    {allPanels.map((r) => (
      <section class="bm-panel" data-bm-panel={r.id} hidden>
        <h3>{t(r.name, lang)}</h3>
        {r.slugs.every((s) => !card(s)) && <p class="bm-soon">{S.soon}</p>}
        <ul class="cond-list">
          {r.slugs.map((s) => card(s)).filter(Boolean).map((c: any) => (
            <li>
              <a class="cond-card" href={url(`${lang}/${c.slug}/`)}>
                <span class="thumb">{thumbImg(c.slug, c.category) ? <img src={thumbImg(c.slug, c.category)!} alt="" loading="lazy" /> : <Icon name="logo" size={40} />}</span>
                <span class="body"><span class="name">{t(c.name, lang)}</span><span class="desc">{t(c.short, lang)}</span></span>
                <span class="go"><Icon name="arrow" size={22} stroke={3} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="care-boxes">
    {boxes.map((bx) => (
      <a class="care-box" href={url(`${lang}/category/${bx.cat}/`)}>
        <span class="care-top">
          <span class="care-title">{bx.title}</span>
          <span class="go"><Icon name="arrow" size={22} stroke={3} /></span>
        </span>
        <span class="care-sub">{bx.sub}</span>
        <span class="care-strip">
          {bx.slugs.map((s) => <img src={asset(`img/thumb/${s}`) ?? ''} alt="" loading="lazy" />)}
        </span>
      </a>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-bodymap]');
    if (!root) return;
    var tabs = root.querySelectorAll('[data-bm-view]');
    var gtabs = root.querySelectorAll('[data-bm-g]');
    var gen = 'm', vw = 'front';
    try { if (localStorage.getItem('kyc-bm-g') === 'f') gen = 'f'; } catch (e) {}
    var figs = root.querySelectorAll('[data-bm-fig]');
    var panels = root.querySelectorAll('[data-bm-panel]');
    var current = null;
    function show() {
      tabs.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-bm-view') === vw ? 'true' : 'false'); });
      gtabs.forEach(function (b) { b.setAttribute('aria-selected', b.getAttribute('data-bm-g') === gen ? 'true' : 'false'); });
      figs.forEach(function (f) { f.hidden = !(f.getAttribute('data-bm-fig') === vw && f.getAttribute('data-bm-gen') === gen); });
    }
    function view(k) { vw = k; show(); select(null); }
    gtabs.forEach(function (b) { b.addEventListener('click', function () {
      gen = b.getAttribute('data-bm-g'); show(); select(null);
      try { localStorage.setItem('kyc-bm-g', gen); } catch (e) {}
    }); });
    show();
    function select(id) {
      current = id;
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-bm-panel') !== id; });
      root.querySelectorAll('.bm-hot').forEach(function (g) { g.classList.toggle('on', g.getAttribute('data-bm-region') === id); });
      if (id) {
        var p = root.querySelector('[data-bm-panel="' + id + '"]');
        if (p && p.scrollIntoView) setTimeout(function () { p.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 50);
      }
    }
    tabs.forEach(function (b) { b.addEventListener('click', function () { view(b.getAttribute('data-bm-view')); }); });
    root.querySelectorAll('.bm-hot').forEach(function (g) {
      var id = g.getAttribute('data-bm-region');
      g.addEventListener('click', function () { select(id); });
      g.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(id); } });
    });
  })();
</script>
