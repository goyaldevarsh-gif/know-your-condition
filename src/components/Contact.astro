---
import site from '../content/site.json';
import cui from '../content/ui-condition.json';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; safety?: boolean }
const { lang, safety = true } = Astro.props;
const L = cui.l;
---
<section class="contact card">
  <h2>{t(L.contactTitle, lang)}</h2>
  <p class="contact-who"><strong>{t(site.doctor, lang)}</strong><span>{t(site.degree, lang)}</span></p>
  <p class="contact-num">{site.phoneDisplay}</p>
  <div class="contact-btns">
    <a class="cbtn cbtn-call" href={`tel:+${site.phoneDigits}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      {t(L.call, lang)}
    </a>
    <a class="cbtn cbtn-wa" href={`https://wa.me/${site.phoneDigits}`} target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.4 7.8L3 21l1.3-4.4A9 9 0 1 1 21 12z"/></svg>
      {t(L.chat, lang)}
    </a>
  </div>
  {safety && <p class="contact-safety">{t(L.safety, lang)}</p>}
</section>
